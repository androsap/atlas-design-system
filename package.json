{
  "name": "atlas-design-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build:atlas",
    "dev": "next dev",
    "dev:atlas": "npm run dev -w @asyst/atlas",
    "prebuild": "npm run build:atlas",
    "build": "next build",
    "build:atlas": "npm run build -w @asyst/atlas",
    "start": "next start",
    "lint": "eslint",
    "tokens:build": "style-dictionary build --config style-dictionary.config.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@asyst/atlas": "*",
    "@radix-ui/react-tabs": "^1.1.21",
    "clsx": "^2.1.1",
    "flag-icons": "^7.5.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shiki": "^4.3.1",
    "simple-icons": "^16.29.0",
    "tailwind-merge": "^3.6.0",
    "world-countries": "^5.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@tailwindcss/postcss": "^4",
    "@tokens-studio/sd-transforms": "^2.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "style-dictionary": "^5.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
